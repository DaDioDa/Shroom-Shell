{
  "name": "pikmin-bloom-shell",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "web"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:fake": "concurrently -k -n server,web -c blue,green \"npm run dev:fake -w server\" \"npm run dev -w web\"",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "teleport": "npm run teleport -w server --",
    "design": "tsx --tsconfig design/tsconfig.json design/build.tsx"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^3.0.0"
  }
}
